{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Presentation.AI Desktop App: Offline Markdown presentations, local file watching, and vector PDF exports.",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "electron dist/main/index.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@presentation-ai/renderer": "workspace:*",
    "@presentation-ai/sync": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3"
  }
}
