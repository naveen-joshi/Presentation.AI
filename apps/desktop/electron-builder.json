{
  "appId": "com.presentationai.desktop",
  "productName": "Presentation.AI",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "src/renderer/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis", "portable"]
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.productivity"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Office"
  }
}
